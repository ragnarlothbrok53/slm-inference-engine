# Copy to .env and adjust. Every setting can also be passed as an environment variable.
# See src/slm_runtime/config.py for the full list, types and bounds.

# Backend: llama_cpp | mlx | fake (fake = no model, for testing the serving stack)
SLM_ENGINE=llama_cpp
SLM_MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
SLM_N_CTX=4096
# CPU threads per replica (unset = llama.cpp default)
# SLM_N_THREADS=8
# Layers to offload to GPU; requires a CUDA/Metal build of llama-cpp-python. -1 = all.
SLM_N_GPU_LAYERS=0
# Independent model instances; each holds its own copy of the weights.
SLM_REPLICAS=1

# Admission control
SLM_MAX_QUEUE_SIZE=32
SLM_REQUEST_TIMEOUT_S=120

# Request limits
SLM_MAX_TOKENS_LIMIT=1024
SLM_MAX_PROMPT_CHARS=32000

# Server / observability
SLM_HOST=127.0.0.1
SLM_PORT=8000
SLM_LOG_LEVEL=INFO
SLM_LOG_JSON=false
